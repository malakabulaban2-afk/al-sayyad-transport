rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function validGps(location) {
      return location is map
        && location.keys().hasAll(["latitude", "longitude", "accuracy", "speed", "bearing", "time", "updatedAt"])
        && location.latitude is number
        && location.latitude >= -90
        && location.latitude <= 90
        && location.longitude is number
        && location.longitude >= -180
        && location.longitude <= 180
        && location.time is number
        && location.updatedAt == request.time;
    }

    function validClaim(truckId) {
      let shiftId = request.resource.data.activeShiftId;
      let shift = getAfter(/databases/$(database)/documents/shifts/$(shiftId)).data;
      return signedIn()
        && (!("activeShiftId" in resource.data) || resource.data.activeShiftId == null)
        && shiftId is string
        && request.resource.data.activeUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["activeShiftId", "activeUid", "activeWorkerName", "assignedAt"])
        && request.resource.data.assignedAt == request.time
        && shift.uid == request.auth.uid
        && shift.shiftId == shiftId
        && shift.truckId == truckId
        && shift.status == "active"
        && shift.startedAt == request.time;
    }

    function validRelease() {
      let shiftId = resource.data.activeShiftId;
      let shift = getAfter(/databases/$(database)/documents/shifts/$(shiftId)).data;
      return signedIn()
        && resource.data.activeUid == request.auth.uid
        && shiftId is string
        && request.resource.data.activeShiftId == null
        && request.resource.data.activeUid == null
        && request.resource.data.activeWorkerName == null
        && request.resource.data.assignedAt == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["activeShiftId", "activeUid", "activeWorkerName", "assignedAt"])
        && shift.uid == request.auth.uid
        && shift.status == "done"
        && shift.endedAt == request.time;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /trucks/{truckId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || validClaim(truckId) || validRelease();
    }

    match /shifts/{shiftId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == "active"
          && request.resource.data.shiftId == shiftId
          && request.resource.data.startedAt == request.time
          && getAfter(/databases/$(database)/documents/trucks/$(request.resource.data.truckId)).data.activeShiftId == shiftId
          && getAfter(/databases/$(database)/documents/trucks/$(request.resource.data.truckId)).data.activeUid == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
          && resource.data.status == "active"
          && request.resource.data.status == "active"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastLocation"])
          && validGps(request.resource.data.lastLocation)
        )
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
          && resource.data.status == "active"
          && request.resource.data.status == "done"
          && request.resource.data.endedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "endedAt"])
        );

      allow delete: if isAdmin();
    }
  }
}
